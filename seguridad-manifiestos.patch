+const jwt = require("jsonwebtoken");
+const UserExternal = require("../../../../models/ManifesTower/UserExternal");
+const Manifiesto = require("../../../../models/AllModulos/Certificacion/Manifiestos");
+const tokenVerify = require("../../../auth/midellware");
+
+const autenticarExterno = async (req, res, next) => {
+    try {
+        const token = req.headers.authorization?.match(/^Bearer\s+(.+)$/i)?.[1];
+        const payload = token && jwt.verify(token, process.env.JWT_SECRET);
+        if (!payload || payload.role !== "EXTERNAL" || !["GENERADOR", "TRANSPORTISTA"].includes(payload.activeRole)) return res.status(401).json({ message: "Inicia sesión nuevamente." });
+        const user = await UserExternal.findById(payload._id);
+        const empresa = payload.activeRole === "GENERADOR" ? user?.generadorId : user?.transportistaId;
+        if (!user || user.estado !== "ACTIVO" || !user.roles.includes(payload.activeRole) || !empresa) return res.status(403).json({ message: "La cuenta no está habilitada para este rol." });
+        req.externalUser = user;
+        req.externalRole = payload.activeRole;
+        next();
+    } catch (_) { return res.status(401).json({ message: "La sesión no es válida o ha expirado." }); }
+};
+const autenticarMixto = (req, res, next) => {
+    const token = req.headers.authorization?.match(/^Bearer\s+(.+)$/i)?.[1];
+    let payload;
+    try { if (token) payload = jwt.verify(token, process.env.JWT_SECRET); } catch (_) { /* tokenVerify responde para tokens internos inválidos */ }
+    return payload?.role === "EXTERNAL" ? autenticarExterno(req, res, next) : tokenVerify(req, res, next);
+};
+const permisoInterno = (permiso) => (req, res, next) => {
+    if (req.externalUser) return next();
+    if (!req.user?._id || req.user.state !== "ACTIVO") return res.status(403).json({ message: "Se requiere un empleado activo identificado." });
+    const permitido = (req.user.modules || []).some((m) => m.submodule?.name?.toUpperCase() === "MANIFIESTOS" && (m.submodule.permissions || []).includes(permiso));
+    if (!permitido) return res.status(403).json({ message: `Se requiere el permiso ${permiso} de MANIFIESTOS.` });
+    next();
+};
+const requiereRol = (rol) => (req, res, next) => req.externalRole === rol ? next() : res.status(403).json({ message: `Se requiere una sesión de ${rol.toLowerCase()}.` });
+const accesoDocumento = (idParam = "id") => async (req, res, next) => {
+    if (!req.externalUser) return next();
+    try {
+        const doc = await Manifiesto.findById(req.params[idParam]).select("generadorId transportistaId estado").lean();
+        if (!doc) return res.status(404).json({ message: "Manifiesto no encontrado." });
+        const propio = req.externalRole === "GENERADOR" ? String(doc.generadorId) === String(req.externalUser.generadorId) && doc.estado !== "BORRADOR" : String(doc.transportistaId) === String(req.externalUser.transportistaId);
+        if (!propio) return res.status(403).json({ message: "No tienes acceso a este manifiesto." });
+        next();
+    } catch (_) { return res.status(400).json({ message: "Identificador de manifiesto inválido." }); }
+};
+module.exports = { autenticarExterno, autenticarMixto, permisoInterno, requiereRol, accesoDocumento };
